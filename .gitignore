# Only explicitly reviewed project roots are eligible for version control.
/*
!/.gitignore
!/.env.example
!/.htaccess
!/AGENTS.md
!/README.md
!/api.php
!/index.php
!/public.php
!/router.php
!/provider_icons.php
!/favicon.svg
!/models.json
!/states.json
!/investigators.json
!/fetch_models.py
!/start.bat
!/assets/
!/cases/
!/lib/
!/tests/
!/tools/
!/docs/

# Secrets, private runtime data, editor caches and local outputs.
.env
.env.*
!/.env.example
*.pem
*.key
*.p12
*.pfx
*.sqlite*
*.log
*.jsonl
*.bak
*.tmp
__pycache__/
*.py[cod]
node_modules/
.DS_Store
Thumbs.db

# Offline source art and generation metadata; runtime portraits are JPG.
/assets/images/grids/
/assets/images/**/*.png
/assets/images/**/*.txt
/assets/images/investigators/manifest.json
/tools/crop_investigators.py
