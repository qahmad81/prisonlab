Options -Indexes
RewriteEngine On
RewriteRule ^(?:index\.php|public\.php|privacy\.php|api\.php|auth\.php|mcp\.php|favicon\.(?:svg|ico))$ - [END]
RewriteRule ^assets/(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_.-]+\.(?:js|css|jpg|jpeg|png|webp|svg)$ - [END]
RewriteRule ^$ index.php [END]
RewriteRule ^[a-z]{2,3}(?:-[a-z0-9]{2,8})*/home/?$ index.php [END]
RewriteRule ^[a-z]{2,3}(?:-[a-z0-9]{2,8})*/privacy/?$ privacy.php [END]
RewriteRule ^[a-z]{2,3}(?:-[a-z0-9]{2,8})*/public(?:/(?:case_file|session|profile|investigator|model|sponsor|funder)/[a-zA-Z0-9_.~:-]+(?:/[a-zA-Z0-9_.~:-]+)?)?/?$ public.php [END]
RewriteRule ^ - [F,END]
